:if ($"pd-valid" = 1) do={
    :local iface "vlan832-orange1.wan1"
    /log info "dhcp6-client $iface script begin"

    :local ifaceinterco "vlan2-interco"
    :local ulagwinterco "fd11:0:0:2::254"
    :local pool "pool6-wan1"
    :local commentregex "DHCLIENT6 orange1"
    
    :local guaiface "0:0:0:1::254/64"
    :local guainterco "0:0:0:2::7/64"

    :local pdprefix $"pd-prefix"
    :local naaddress $"na-address"
    :local navalid $"na-valid"
 
    :local prefixinterco
    :local check
    :local checkcount
	:local checkpos

    :set ulagwinterco ($ulagwinterco . "%" . $ifaceinterco)

    /log info "dhcp6-client def interface:$iface|$guaiface interco:$ifaceinterco|$guainterco|(via $ulagwinterco) pool:$pool pd-prefix:$pdprefix comment:($commentregex) na-address:$naaddress na-valid:$navalid"

    # ip6 addr wan1 
    /ipv6 address set [find where interface=$iface from-pool=$pool comment~$commentregex ] address=$guaiface comment="wan1 pool (ONLY tiergw) - $commentregex"

    # ip6 addr interco
    /ipv6 address set [find where interface=$ifaceinterco from-pool=$pool comment~$commentregex ] address=$guainterco comment="wan1 pool - interco (ONLY tiergw OPTION) - $commentregex"

    #
    # routes
    #
    # ip6 prefix route via ULA interco
    :set check [ /ipv6 route find where gateway=$ulagwinterco comment~$commentregex ]
    :set checkcount [:len $check]
    :if ($checkcount = 1) do={
        /ipv6 route set $check dst-address=$"pd-prefix" comment="wan1 pool - prefix via ULA iface (ONLY tiergw) - $commentregex"
    } else={
        /log warning "dhcp6-client gua prefix route gateway:$ulagwinterco update skipped, expected 1 route and found $checkcount"
    }
    
    # ip6 prefix route via iface interco
    :set check [ /ipv6 route find where gateway=$ifaceinterco comment~$commentregex ]
    :set checkcount [:len $check]
    :if ($checkcount = 1) do={
        :delay 1
        :set guainterco [ /ipv6 address get [ find where interface=$ifaceinterco from-pool=$pool comment~$commentregex ] address ]
		:set checkpos [:find $guainterco "::"]
        /log info "dhcp6-client interco:$ifaceinterco gateway:$ifaceinterco address:$guainterco pos:$checkpos"
		:if ($checkpos > 0) do={
    		:set prefixinterco ([:pick $guainterco 0 $checkpos] . "::/64")
    		/log info "dhcp6-client interco:$ifaceinterco gateway:$ifaceinterco address:$guainterco prefix:$prefixinterco"
    		/ipv6 route set $check dst-address=$prefixinterco comment="wan1 pool - interco prefix via iface (ONLY tiergw) - $commentregex"
		} else={
    		/log warning "dhcp6-client unable to derive interco prefix, address $guainterco does not contain ::"
		}
    } else={   
        /log warning "dhcp6-client interco prefix route gateway:$ifaceinterco update skipped, expected 1 route and found $checkcount"
    }

    # multiwan
    /routing rule set [ find where action=lookup table=route-wan1 comment~$commentregex ] src-address=$"pd-prefix" comment="wan1 fib - $commentregex"

    # firewall address-list
    /ipv6/firewall/address-list set [find where list=lan comment~$commentregex ] address=$"pd-prefix" comment="wan1 pool - $commentregex" dynamic=no

    # firewall netmap
    /ipv6/firewall/nat set [find where chain=srcnat action=netmap out-interface=$iface src-address="fd11::/56" comment~$commentregex ] to-address=$"pd-prefix" comment="wan1 netmap ULA - $commentregex"

    # netwatch
    :if ($navalid = 1) do={
        /tool netwatch set [ find where type=icmp comment~$commentregex ] src-address=$"na-address" comment="wan1 src - $commentregex"
    } else={
        /log info "dhcp6-client na-address not valid (na-valid $navalid), skipping netwatch src-address update"
    }
    /log info "dhcp6-client $iface script finished"
}
